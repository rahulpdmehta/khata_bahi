NODE_ENV=development
PORT=3000

# Runtime (Vercel + app): Prisma Accelerate URL — NOT the migration/direct URL
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=your_api_key"
# Migrations only (prisma migrate / db push). Never set this as DATABASE_URL on Vercel.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Secrets (CHANGE IN PRODUCTION!)
JWT_SECRET=dev_jwt_secret_change_in_production_123456
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production_123456

# CORS
CORS_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
